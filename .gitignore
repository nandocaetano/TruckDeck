# generated build output — regenerate with: node tools/build.js
dist/

# bridge build tooling (pkg) — regenerate with: npm install && npm run build:exe
bridge/node_modules/
bridge/package-lock.json

# runtime data: PIN secret, logs, user-saved layouts (created on first run, not source)
data/

# large non-source archive
_update.zip

# QA / review screenshots (local proof captures, not source)
_review_*.png
_review_*.jpg
_review_*.jpeg
_qa_*.png
qa-*.png
qa-*.jpg
qa-*.jpeg
qa_*.png
qa_*.jpg
qa_*.jpeg
qa-*.patch

# manual backup folders/files predating git (kept on disk, not tracked)
_backup_*
backups/
_bak_*/
*.bak
*.*.bak
public/*Copia*

# local lock, machine settings, and helper binaries (not source)
.lock
settings.json
*.exe

# python bytecode cache
__pycache__/

# Android build artifacts (also covered by android/.gitignore, kept here for root-level clarity)
android/.gradle/
android/app/build/
android/local.properties

# generated layout CSS (runtime artifact, not source)
public/layout.generated.css

# boot logo segments (generated assets, not source)
public/skins/modern/dash/boot_logo_segments/
