# Normalize all text files to LF in the repo; CRLF on Windows checkout only for .bat
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.java text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.exe binary
*.jks binary
*.jar binary
*.aab binary
*.apk binary
*.zip binary
*.mp4 binary
*.webm binary
